# Default: text files get LF in repo, CRLF on Windows checkout
* text=auto

# Go source files: always LF
*.go text eol=lf

# Shell scripts: always LF (must work on Linux)
*.sh text eol=lf
internal/installtmpl/S99wg-monitor text eol=lf

# Python relay: always LF (embedded into the backend + run on the Linux VPS)
*.py text eol=lf

# Web fonts: never convert (binary)
*.woff2 binary
*.woff binary

# Systemd unit files: always LF
*.service text eol=lf

# YAML templates: LF
*.yaml text eol=lf
*.yaml.tmpl text eol=lf

# Caddyfile template: LF
Caddyfile.tmpl text eol=lf

# Deploy templates: always LF (rendered on the dev/build machine but executed
# by dash on Entware routers or systemd on the VPS; CRLF breaks `set -eu`)
*.tmpl text eol=lf
*.timer text eol=lf
cmd/deploy/templates/awgm-bootstrap.sh.tmpl text eol=lf
cmd/deploy/templates/wg-monitor-backup.service.tmpl text eol=lf
cmd/deploy/templates/wg-monitor-backup.timer text eol=lf

# Binary files: no conversion
*.exe binary
*.db binary
