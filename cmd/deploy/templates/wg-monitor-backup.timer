[Unit]
Description=Daily wg-monitor state.db backup
Documentation=https://github.com/anex/wg-monitor

[Timer]
# 03:30 UTC каждый день — нагрузка минимальна, retention.PruneBefore
# к этому времени успевает закончиться (default scan на старте часа).
OnCalendar=*-*-* 03:30:00 UTC
# Если VPS был выключен в момент срабатывания — догнать при старте.
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
