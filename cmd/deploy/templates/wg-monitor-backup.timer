[Unit]
Description=Daily wg-monitor Telegram backup
Documentation=https://github.com/Jkaotlic/wg-monitor

[Timer]
# Send the recovery bundle to the admin's private Telegram chat every morning.
OnCalendar=*-*-* 05:00:00 Europe/Moscow
# Catch up after VPS downtime.
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
