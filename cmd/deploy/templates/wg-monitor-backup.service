[Unit]
Description=wg-monitor Telegram backup
Documentation=https://github.com/anex/wg-monitor

[Service]
Type=oneshot
User=wgmonitor
Group=wgmonitor
ExecStart=/usr/local/lib/wg-monitor/wg-monitor-backup-telegram.sh

# Hardening mirrors the backend service, with network enabled for Telegram API.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wg-monitor
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryDenyWriteExecute=true
