[Unit]
Description=wg-monitor state.db backup
Documentation=https://github.com/anex/wg-monitor

[Service]
Type=oneshot
User=wgmonitor
Group=wgmonitor

# sqlite3 .backup даёт consistent snapshot live-DB без exclusive-lock'а
# (использует SQLite's online-backup API). VACUUM INTO дополнительно
# сжимает результат — может занять секунды на больших БД, но даёт
# ~2× меньшее backup-file. Прогон каждый день в 3:30 UTC.
ExecStart=/bin/sh -c 'umask 077; /usr/bin/sqlite3 /var/lib/wg-monitor/state.db "VACUUM INTO \"/var/lib/wg-monitor/backup-$(date -u +%%Y%%m%%dT%%H%%M%%SZ).db\""'
# Удерживаем последние 7 дней; всё старше — удаляем.
ExecStartPost=/bin/sh -c 'find /var/lib/wg-monitor -maxdepth 1 -name "backup-*.db" -mtime +7 -delete'

# Hardening — копируем профиль с основного сервиса.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wg-monitor
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryDenyWriteExecute=true
