[Unit]
Description=wg-monitor backend
Documentation=https://github.com/Jkaotlic/wg-monitor
After=network-online.target
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=wgmonitor
Group=wgmonitor
ExecStart=/usr/local/bin/wg-monitor-backend -config /etc/wg-monitor/backend.yaml
Restart=always
RestartSec=5

# --- Hardening (DEPLOY-10) ---
# Pure-Go HTTP+SQLite service: no kernel modules, no /proc/sys writes, no
# device access, no exec'ing children. Almost the entire systemd hardening
# bundle is safe to enable; what's not enabled is documented per-line.

# Filesystem
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wg-monitor
StateDirectory=wg-monitor
PrivateTmp=true
PrivateDevices=true
ProtectProc=invisible
ProcSubset=pid

# Kernel/runtime
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

# Networking — IPv4/IPv6 + AF_UNIX (DEPLOY-02). AF_UNIX нужен сценарию
# «свой VPN-сервер на локальном Docker»: selfhostedamnezia.DockerRunner
# exec'ит `docker`, а тот ходит в /var/run/docker.sock. Без AF_UNIX такая
# площадка молча не работает.
#
# ВНИМАНИЕ: самого семейства мало — службе ещё нужен ДОСТУП к сокету. Доступ
# к /var/run/docker.sock == root на хосте (через docker run -v /:/host любой
# контейнер читает всё), поэтому шаблон НЕ добавляет SupplementaryGroups=docker
# сам: решение принимает оператор, явно:
#   sudo usermod -aG docker wgmonitor
# или drop-in с SupplementaryGroups=docker на конкретной площадке, где
# локальный Docker действительно используется.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Capabilities — drop everything; service binds to 127.0.0.1:8080, no
# privileged port needed.
CapabilityBoundingSet=
AmbientCapabilities=

# Syscalls — common system service profile + json/sqlite + http.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

# Limits — bounded RAM and process count protect the host from a leak/
# fork bomb in our process. Adjust MemoryMax if SQLite cache + WAL grows
# beyond 256MiB on real-fleet load.
MemoryMax=512M
TasksMax=128
LimitNOFILE=65535

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
