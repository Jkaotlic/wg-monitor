backend:
  url: {{.BackendURL}}
  token: "{{.Token}}"

agent:
  nickname: {{.Nickname}}
  interval_sec: 60

awg_manager:
  base_url: http://127.0.0.1:2222
  # awg-manager 2.10+ documents cookie auth for most /api endpoints.
  # Leave login/password empty for local installations without auth; set them
  # (or password_file) if your awg-manager requires a session.
  # login: admin
  # password_file: /opt/etc/wg-monitor/awg-manager-password.txt

checks:
  dns:
    auto_discover: true
    test_domain: "example.com"
    fail_threshold: 2

external_reach:
  enabled: true
  bind_to_default: true
  fail_threshold: 2

state:
  path: /opt/var/wg-monitor/state.json

# Maintenance panel destructive-op gates. Both default to false in code;
# wizard enables them on add-router because the operator explicitly
# onboarded this router for ops. Edit to false here for paranoid setups.
maintenance:
  allow_router_reboot: true
  allow_firmware_install: true
