listen: 127.0.0.1:8080
log_level: info
public_base_url: "{{.PublicBaseURL}}"
db_path: /var/lib/wg-monitor/state.db

# bot_token is read from a separate file (mode 0600, owned by wgmonitor)
# so the main config can stay readable for debugging without exposing the
# token. Agents/users live in the SQLite DB at db_path — managed via
# `wg-monitor-cli add-user` (called by the wizard's [4] Add Router action)
# — and are NOT mirrored here.
telegram:
  bot_token_file: /etc/wg-monitor/bot-token.txt
  chat_id: {{.ChatID}}
  # Additional operator supergroups allowed to use the same bot. Routers must
  # be bound to one of these chats with `wg-monitor-cli bind-topic --chat-id`.
{{if .ExtraChatIDs}}
  extra_chat_ids:
{{range .ExtraChatIDs}}
    - {{.}}
{{end}}
{{else}}
  extra_chat_ids: []
{{end}}
  admin_user_id: {{.AdminUserID}}

state:
  fail_threshold: 2
  recovery_threshold: 2
  mobile_fail_threshold: 6
  mute_cutoff_hour: 23
  realert_every_sec: 3600
  mobile_realert_every_sec: 21600
  realert_tick_sec: 60

heartbeat:
  stale_after_sec: 120
  stale_after_static_sec: 180
  stale_after_mobile_sec: 3600   # legacy HARD-OFFLINE threshold; applied only if mobile_lifecycle=false
  mobile_lifecycle: true         # wake-card (🚗) on Resumed=true + one-shot sleep-info (🌙) after mobile_sleep_after_sec
  mobile_sleep_after_sec: 1800   # mobile silence threshold for the one-shot sleep info-card
  resume_grace_sec: 120
  scan_interval_sec: 30

# Soft-warning Updates section sources for the Maintenance panel +
# 📊 Что происходит? smart-reply. Empty repo → that source is silently
# skipped (no false-positive warnings). Cache TTL defaults to 12h.
upstream:
  awgmgr_repo: "hoaxisr/awg-manager"
  hrneo_repo: ""    # Ground-Zerro/HydraRoute publishes via opkg feed, not GitHub releases — leave empty
  cache_ttl: 12h

# DB maintenance: prune old events, VACUUM, WAL checkpoint. Defaults below
# are conservative; set any field to 0 (or omit) to disable that operation.
retention:
  events_days: 30
  vacuum_interval: 168h
  wal_checkpoint_every: 1h

# Amnezia Premium cabinet helper. vpn:// keys are stored outside state.db so
# the Telegram backup archive does not include subscription secrets.
amnezia_premium:
  secrets_path: /var/lib/wg-monitor/amnezia-premium.json
  # base_url may be left empty: backend resolves the official CP mirror.
  base_url: ""

# UI tweaks. compat_inline_keyboard duplicates the per-topic ReplyKeyboardMarkup
# as inline buttons under bot replies. This is the default because TG Desktop
# often drops bottom ReplyKeyboard buttons inside forum topics; inline buttons
# render consistently on Desktop and mobile. Set false only if you prefer the
# mobile-style bottom keyboard and do not need Desktop forum-topic reliability.
ui:
  compat_inline_keyboard: true

# VPS dashboard: serves /dashboard/ and /v1/dashboard/* from wg-monitor-backend.
# Keep disabled until /etc/wg-monitor/dashboard-token.txt exists with mode 0600.
# If enabled=true and the file is missing or empty, backend startup fails closed.
dashboard:
  enabled: false
  token_file: /etc/wg-monitor/dashboard-token.txt

# Wizard sync token: enables /v1/wizard/agents read + PUT for the deploy
# wizard so any admin PC sees the same fleet picture. Generated by the
# wizard at install-backend time. If the file is missing or empty the
# endpoints are NOT registered (fail-closed).
wizard:
  token_file: /etc/wg-monitor/wizard-token.txt
  # The public wizard endpoint writes backend self-update requests here.
  # A host-side wg-monitor-backend-update.timer consumes the file and restarts
  # the backend locally, so future backend updates do not require SSH reachability.
  backend_update_file: /var/lib/wg-monitor/backend-update.json

# Dead-man digest: once-a-day "🟢 Монитор жив — N/M роутеров онлайн" to the
# primary chat. Its ABSENCE is the signal — if the digest stops arriving, the
# backend is down. Opt-in; pair with an external probe
# (docs/external-uptime-probe.md) for a hard guarantee outside the failure domain.
digest:
  enabled: false
  hour_msk: 9
  online_window_sec: 600
