listen: 127.0.0.1:8080
log_level: info
db_path: /var/lib/wg-monitor/state.db

# bot_token is read from a separate file (mode 0600, owned by wgmonitor)
# so the main config can stay readable for debugging without exposing the
# token. Agents/users live in the SQLite DB at db_path — managed via
# `wg-monitor-cli add-user` (called by the wizard's [4] Add Router action)
# — and are NOT mirrored here.
telegram:
  bot_token_file: /etc/wg-monitor/bot-token.txt
  chat_id: {{.ChatID}}
  admin_user_id: {{.AdminUserID}}

state:
  fail_threshold: 2
  recovery_threshold: 2
  mute_cutoff_hour: 23
  realert_every_sec: 3600
  realert_tick_sec: 60

heartbeat:
  stale_after_sec: 120
  stale_after_static_sec: 180
  stale_after_mobile_sec: 300
  resume_grace_sec: 30
  scan_interval_sec: 30

# Soft-warning Updates section sources for the Maintenance panel +
# 📊 Что происходит? smart-reply. Empty repo → that source is silently
# skipped (no false-positive warnings). Cache TTL defaults to 12h.
upstream:
  awgmgr_repo: "hoaxisr/awg-manager"
  hrneo_repo: ""    # Ground-Zerro/HydraRoute publishes via opkg feed, not GitHub releases — leave empty
  cache_ttl: 12h

# DB maintenance: prune old events, VACUUM, WAL checkpoint. Defaults below
# are conservative; set any field to 0 (or omit) to disable that operation.
retention:
  events_days: 30
  vacuum_interval: 168h
  wal_checkpoint_every: 1h

# UI tweaks. compat_inline_keyboard duplicates the per-topic ReplyKeyboardMarkup
# as inline buttons under every bot reply — set to true if your operators sit
# on TG Desktop in forum topics where the bottom keyboard panel intermittently
# disappears. Mobile users keep the native bottom panel either way (well, with
# this on they get inline buttons instead — there's no per-user override yet).
ui:
  compat_inline_keyboard: false

# Wizard sync token: enables /v1/wizard/agents read + PUT for the deploy
# wizard so any admin PC sees the same fleet picture. Generated by the
# wizard at install-backend time. If the file is missing or empty the
# endpoints are NOT registered (fail-closed).
wizard:
  token_file: /etc/wg-monitor/wizard-token.txt
