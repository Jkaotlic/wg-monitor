[Unit]
Description=wg-monitor encrypted Telegram backup
Documentation=https://github.com/Jkaotlic/wg-monitor

[Service]
Type=oneshot
User={{.User}}
Group={{.Group}}
ExecStart={{.BinaryPath}} backup --config {{.ConfigPath}} --passphrase-file {{.PassphrasePath}} --operator-vault {{.OperatorVault}} --out-dir {{.OutDir}}{{if .LayoutRoot}} --layout-root {{.LayoutRoot}}{{end}}{{if .SendTelegram}} --send-telegram{{end}}

# Hardening mirrors the backend service, with network enabled for Telegram API.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome={{.ProtectHomeMode}}
ReadWritePaths={{.ReadWritePath}}
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryDenyWriteExecute=true
